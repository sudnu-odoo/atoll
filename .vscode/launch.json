{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug atoll",
      "cargo": {
        "args": ["build", "--bin=atoll", "--package=atoll"],
        "filter": { "name": "atoll", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "atoll=debug",
        "RUST_BACKTRACE": "1",
        "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug atoll (release)",
      "cargo": {
        "args": ["build", "--release", "--bin=atoll", "--package=atoll"],
        "filter": { "name": "atoll", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "atoll=info",
        "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
      }
    }
  ]
}
